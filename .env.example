# Public origin for redirects + webhooks
PUBLIC_URL=http://127.0.0.1:43149

# Cursor Cloud Agents API key (Dashboard → API Keys)
CURSOR_API_KEY=
CURSOR_STATUS_WEBHOOK_SECRET=

# GitHub provisioning for personal agent repos
GITHUB_TOKEN=
# Optional org login. If unset, repos are created under the token's user account.
GITHUB_ORG=
# Optional: owner/repo or https://github.com/org/agent-template
AGENT_TEMPLATE_REPO=

# Security
SESSION_SECRET=generate-a-long-random-string
VAULT_MASTER_KEY=generate-another-long-random-string
CRON_SECRET=generate-a-long-random-string
# Comma-separated emails allowed on /app/admin (empty = all signed-in users)
OPERATOR_EMAILS=

# Optional Slack (not required)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=xoxb-
# OPERATOR_SLACK_IDS=

# Store — production on Vercel: use Upstash Redis (not Vercel Blob; avoids Blob quota outages)
# UPSTASH_REDIS_REST_URL=          # or KV_REST_API_URL from Vercel → Upstash integration
# UPSTASH_REDIS_REST_TOKEN=       # or KV_REST_API_TOKEN
# PERSONAL_AGENTS_STORE=redis       # or supabase | blob | file
# PERSONAL_AGENTS_DISABLE_BLOB=1    # ignore BLOB_STORE_ID after migrating off Blob
#
# Supabase (free tier; can reuse Pocketedge project — run scripts/supabase-store-migration.sql)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PERSONAL_AGENTS_SUPABASE_FILES_BUCKET=personal-agents-files
#
# Relational store (per-job / per-thread rows — lower egress than the single jsonb blob)
# 1) Run scripts/supabase-relational-store-migration.sql
# 2) npx tsx --env-file=.env.local scripts/migrate-blob-to-relational.ts
# 3) PERSONAL_AGENTS_RELATIONAL=1
# 4) After verifying, optional: PERSONAL_AGENTS_SKIP_BLOB_WRITE=1
# PERSONAL_AGENTS_RELATIONAL=1
# PERSONAL_AGENTS_SKIP_BLOB_WRITE=0
# PERSONAL_AGENTS_MAX_JOBS_PER_USER=200

# Allow /api/auth/dev-login in production (optional)
# ALLOW_DEV_LOGIN=true
